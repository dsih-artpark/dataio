# =============================================================================
# DataIO Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# Optional variables show their default values

# =============================================================================
# Database Configuration [REQUIRED]
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=catalogue

# =============================================================================
# AWS Configuration [REQUIRED for S3/SES]
# =============================================================================
# Note: AWS_ACCESS_KEY is deprecated, use AWS_ACCESS_KEY_ID instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# =============================================================================
# JWT Authentication [REQUIRED]
# =============================================================================
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Optional JWT settings (defaults shown)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=dataio_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# Email Configuration
# =============================================================================
# Set to true for local development - prints OTPs to console instead of sending
DEBUG_EMAIL=true

# Email provider: "ses" (default, uses AWS SES) or "smtp"
EMAIL_PROVIDER=ses

# Sender details
EMAIL_FROM_ADDRESS=noreply@dataio.artpark.ai
EMAIL_FROM_NAME=DataIO

# --- AWS SES Configuration (when EMAIL_PROVIDER=ses) ---
AWS_SES_REGION=ap-south-1

# --- SMTP Configuration (when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =============================================================================
# OTP Configuration (Optional - defaults shown)
# =============================================================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MINUTES=1
OTP_SECRET_KEY=

# =============================================================================
# WebAuthn/Passkeys Configuration [REQUIRED for production]
# =============================================================================
# RP ID should be your domain (without protocol or port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DataIO
# Origin must match your frontend URL exactly (including protocol and port)
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_EXPIRY_MINUTES=5

# =============================================================================
# Web Authentication / OAuth Configuration
# =============================================================================
FRONTEND_URL=http://localhost:3000
WEB_API_BASE_URL=http://localhost:8000

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/web/auth/oauth/google/callback

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/web/auth/oauth/github/callback

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# =============================================================================
# API Key Configuration (Optional - defaults shown)
# =============================================================================
API_KEY_LENGTH=32
API_KEY_PREFIX=dio_

# =============================================================================
# Database Schema Management (for scripts)
# =============================================================================
REPO_DIR=${HOME}/Documents/work/code/dataio/src/dataio
SCHEMA_FILE_TO_RESTORE=${HOME}/.sqldumps/schema.sql
DATA_FILE_TO_RESTORE=${HOME}/.sqldumps/data.sql
REPO_SCHEMA_DUMP_LOCATION=${REPO_DIR}/db/schema.sql
LOCAL_SCHEMA_DUMP_LOCATION=${HOME}/.sqldumps/schema.sql
LOCAL_DATA_DUMP_LOCATION=${HOME}/.sqldumps/data.sql
MIGRATIONS_DIR=${REPO_DIR}/db/migrations
DB_DUMP_S3_URI=s3://bucket/path/

# =============================================================================
# AI Chat Assistant
# =============================================================================
# Provider selection: "bedrock" (default) or "openrouter"
CHAT_PROVIDER=bedrock

# Maximum tool iterations per message (optional, default: 10)
CHAT_MAX_TOOL_ITERATIONS=10

# --- AWS Bedrock Configuration (when CHAT_PROVIDER=bedrock) ---
# Region where Bedrock is available (must have Claude model access)
AWS_BEDROCK_REGION=us-east-1

# Claude model to use for chat
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- OpenRouter Configuration (when CHAT_PROVIDER=openrouter) ---
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Base URL (optional, default shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use (see https://openrouter.ai/models for available models -
# check this list before deploying, OpenRouter retires/renames slugs over time)
# Examples: anthropic/claude-sonnet-5, openai/gpt-4-turbo, google/gemini-pro
OPENROUTER_MODEL_ID=anthropic/claude-sonnet-5

# =============================================================================
# Metadata Drafter (LLM-drafted metadata.yaml, pending curator review)
# =============================================================================
# Uses the same OPENROUTER_API_KEY/OPENROUTER_BASE_URL above regardless of
# CHAT_PROVIDER - drafting always goes through OpenRouter, not Bedrock.
# Model override (optional - falls back to OPENROUTER_MODEL_ID if unset).
DRAFTER_MODEL_ID=anthropic/claude-sonnet-5

# Extended-thinking/reasoning controls (both optional, unset by default - the
# drafter is already slow on large CSVs, so reasoning tokens are opt-in, not a
# silent extra cost/latency hit). Set at most one of these:
# DRAFTER_REASONING_EFFORT=high          # low | medium | high
# DRAFTER_REASONING_MAX_TOKENS=8000      # explicit thinking-token budget; takes priority over EFFORT if both are set

# Where uploaded CSVs/digitization logs from the "Generate draft" web form
# are stored on local disk while a draft is pending review (drafts are not
# in S3 yet - that only happens on approval).
DRAFT_UPLOAD_DIR=data/manifest_draft_uploads

# =============================================================================
# SDK Configuration (for CLI/SDK usage)
# =============================================================================
DATAIO_API_KEY=
DATAIO_API_BASE_URL=
DATAIO_DATA_DIR=data
