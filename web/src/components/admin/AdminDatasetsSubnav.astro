---
const currentPath = Astro.url.pathname;

const items = [
  { href: '/admin/datasets', label: 'Overview' },
  { href: '/admin/datasets/new', label: 'Create / Import' },
  { href: '/admin/datasets/catalog', label: 'Catalog' },
  { href: '/admin/datasets/reservations', label: 'Reserved IDs' },
  { href: '/admin/datasets/sync', label: 'Documentation Sync' },
];

const isDatasetWorkspace =
  currentPath.startsWith('/admin/datasets/') &&
  !items.some((item) => currentPath === item.href || currentPath.startsWith(`${item.href}/`));
---

<div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
  <nav class="flex flex-wrap gap-2" aria-label="Dataset admin navigation">
    {items.map((item) => {
      const active =
        currentPath === item.href || (item.href !== '/admin/datasets' && currentPath.startsWith(`${item.href}/`));
      return (
        <a
          href={item.href}
          class:list={[
            'rounded-xl px-4 py-2 text-sm font-medium transition',
            active
              ? 'bg-slate-900 text-white'
              : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
          ]}
        >
          {item.label}
        </a>
      );
    })}

    {isDatasetWorkspace ? (
      <span class="rounded-xl bg-amber-100 px-4 py-2 text-sm font-medium text-amber-900">
        Dataset Workspace
      </span>
    ) : null}
  </nav>
</div>
