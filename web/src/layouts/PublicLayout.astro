---
// Layout for the public site: skip link, header, footer, optional
// back-to-top. Pages with full-bleed sections (the landing page) pass
// width="full" and size their own sections; others get the 1200px column.
import PublicHeader, { type PublicNavKey } from '../components/public/PublicHeader';
import PublicFooter from '../components/public/PublicFooter.astro';
import BackToTop from '../components/public/BackToTop';
import { PLATFORM_NAME } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Highlights this header link. */
  current?: PublicNavKey;
  width?: 'contained' | 'full';
  background?: 'white' | 'gray';
  backToTop?: boolean;
}

const {
  title,
  description = 'Human and animal health, population, livestock and weather datasets for India, documented and standardised at ARTPARK, IISc.',
  current,
  width = 'contained',
  background = 'gray',
  backToTop = false,
} = Astro.props;

const pageTitle = title === PLATFORM_NAME ? title : `${title} | ${PLATFORM_NAME}`;
const mainClass =
  width === 'full' ? 'flex-1 focus:outline-none' : 'flex-1 w-full max-w-page mx-auto px-4 sm:px-6 py-8 focus:outline-none';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class={`min-h-screen flex flex-col text-gray-900 ${background === 'white' ? 'bg-white' : 'bg-gray-50'}`}>
    <div id="top" tabindex="-1" class="focus:outline-none"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-primary-700 focus:shadow-lg"
    >
      Skip to content
    </a>

    <PublicHeader client:load current={current} />

    <main id="main" tabindex="-1" class={mainClass}>
      <slot />
    </main>

    <PublicFooter />

    {backToTop && <BackToTop client:idle />}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
