---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import APIKeyManager from '../../components/account/APIKeyManager';
---

<DashboardLayout title="API Keys">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">API Keys</h1>
      <p class="mt-1 text-gray-600">
        Manage your API keys for programmatic access to DataIO.
      </p>
    </div>

    <APIKeyManager client:load />
  </div>
</DashboardLayout>

<script>
  import { initAuth, requireAuth } from '../../lib/auth';
  initAuth().then(() => requireAuth());
</script>
