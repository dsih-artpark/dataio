---
import DatasetAdminManager from '../../components/admin/DatasetAdminManager';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Manage Datasets" fullWidth={true}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Manage Datasets</h1>
      <p class="mt-1 text-gray-600">
        Create datasets, maintain raw dataset links, upload tables, manage canonical manifests, and sync dataset documentation.
      </p>
    </div>

    <DatasetAdminManager client:load />
  </div>
</DashboardLayout>

<script>
  import { requireAuthenticatedPage } from '../../lib/auth';

  requireAuthenticatedPage({ adminOnly: true });
</script>
