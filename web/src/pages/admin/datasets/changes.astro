---
import AdminDatasetsSubnav from '../../../components/admin/AdminDatasetsSubnav.astro';
import DatasetChangeManager from '../../../components/admin/DatasetChangeManager';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Dataset changes" fullWidth={true}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Dataset changes</h1>
      <p class="mt-1 text-gray-600">
        The changelog shown on each dataset's public Version history. Replacing a dataset saves a draft here; publish it
        to make it public. Add entries by hand for metadata-only edits.
      </p>
    </div>

    <AdminDatasetsSubnav />
    <DatasetChangeManager client:load />
  </div>
</DashboardLayout>

<script>
  import { requireAuthenticatedPage } from '../../../lib/auth';

  requireAuthenticatedPage({ adminOnly: true });
</script>
