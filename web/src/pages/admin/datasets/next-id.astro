---
import AdminDatasetsSubnav from '../../../components/admin/AdminDatasetsSubnav.astro';
import DatasetAdminManager from '../../../components/admin/DatasetAdminManager';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Next Available IDs" fullWidth={true}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Next Available IDs</h1>
      <p class="mt-1 text-gray-600">
        Look up the next free dataset ID and raw dataset ID for a collection before authoring metadata.yaml / info.yml.
      </p>
    </div>

    <AdminDatasetsSubnav />
    <DatasetAdminManager view="ids" client:load />
  </div>
</DashboardLayout>

<script>
  import { requireAuthenticatedPage } from '../../../lib/auth';

  requireAuthenticatedPage({ adminOnly: true });
</script>
