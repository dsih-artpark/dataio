---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import GroupManager from '../../components/admin/GroupManager';
---

<DashboardLayout title="Groups">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Group Management</h1>
      <p class="mt-1 text-gray-600">
        Manage groups and their members for permission control.
      </p>
    </div>

    <GroupManager client:load />
  </div>
</DashboardLayout>

<script>
  import { initAuth, requireAuth, isAdmin } from '../../lib/auth';

  // Check auth immediately
  if (!requireAuth()) {
    // Not authenticated, redirecting
  } else {
    // Initialize auth and check admin status
    initAuth().then(() => {
      if (!isAdmin()) {
        window.location.replace('/datasets');
      }
    });
  }
</script>
