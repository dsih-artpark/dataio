---
import ManifestValidationManager from '../../components/admin/ManifestValidationManager';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Manifest Validation">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Manifest Validation</h1>
      <p class="mt-1 text-gray-600">
        Validate a candidate manifest and optional dataset file before you update the canonical standardised manifest.
      </p>
    </div>

    <ManifestValidationManager client:load />
  </div>
</DashboardLayout>

<script>
  import { initAuth, requireAuth, isAdmin } from '../../lib/auth';

  if (!requireAuth()) {
    // Not authenticated, redirecting
  } else {
    initAuth().then(() => {
      if (!isAdmin()) {
        window.location.replace('/datasets');
      }
    });
  }
</script>
