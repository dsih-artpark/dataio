---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DataChat from '../components/chat/DataChat';
---

<DashboardLayout title="Data Assistant - DataIO">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Data Assistant</h1>
    <p class="text-gray-600 mt-1">
      Chat with our AI assistant to discover and explore datasets. Ask questions about available data,
      search by topic, or get details about specific datasets.
    </p>
  </div>

  <div class="h-[calc(100vh-220px)] min-h-[500px]">
    <DataChat client:load />
  </div>
</DashboardLayout>
