---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DatasetTable from '../../components/datasets/DatasetTable';
---

<DashboardLayout title="Datasets">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Datasets</h1>
      <p class="mt-1 text-gray-600">
        Browse and download datasets you have access to.
      </p>
    </div>

    <DatasetTable client:load />
  </div>
</DashboardLayout>

<script>
  import { initAuth, requireAuth } from '../../lib/auth';

  // Check auth immediately before doing anything else
  if (!requireAuth()) {
    // Not authenticated, redirecting - don't initialize anything
  } else {
    // Authenticated, initialize auth state
    initAuth();
  }
</script>
