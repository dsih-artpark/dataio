---
// One dataset (redesign wireframe v2, "Dataset page"): /dataset?id=<ds_id>.
// The site is static, so the ID is read in the browser.
import PublicLayout from '../layouts/PublicLayout.astro';
import DatasetPage from '../components/public/datasets/DatasetPage';
---

<PublicLayout title="Dataset" current="datasets">
  <div class="flex flex-col gap-7 pb-12">
    <a href="/datasets" class="self-start text-sm font-semibold text-primary-700 hover:text-primary-900">← All datasets</a>
    <DatasetPage client:load />
  </div>
</PublicLayout>
