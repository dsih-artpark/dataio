---
import PublicLayout from '../../layouts/PublicLayout.astro';
import DatasetBrowser from '../../components/datasets/DatasetBrowser';
---

<PublicLayout title="Browse Datasets">
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Datasets</h1>
      <p class="mt-1.5 text-gray-600">
        Explore research-grade datasets curated at ARTPARK
      </p>
    </div>

    <DatasetBrowser client:load />
  </div>
</PublicLayout>
