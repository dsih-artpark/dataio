---
import UnifiedNav from '../../components/common/UnifiedNav';
import DatasetBrowser from '../../components/datasets/DatasetBrowser';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Explore research-grade datasets curated at ARTPARK" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Browse Datasets | ARTPARK Data Platform</title>
  </head>
  <body class="min-h-screen bg-gray-50 flex flex-col">
    <!-- Unified Navigation -->
    <UnifiedNav client:load />

    <!-- Main content - wider for dataset browser -->
    <main class="flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="max-w-[1800px] mx-auto">
        <div class="mb-4">
          <h1 class="text-2xl font-bold text-gray-900">Datasets</h1>
          <p class="mt-1 text-gray-600">
            Explore research-grade datasets curated at ARTPARK
          </p>
        </div>

        <DatasetBrowser client:load />
      </div>
    </main>

    <!-- Minimal footer for browser view -->
    <footer class="flex-shrink-0 bg-white border-t border-gray-200 py-3">
      <div class="max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between text-xs text-gray-500">
          <p>&copy; {new Date().getFullYear()} ARTPARK</p>
          <nav class="flex gap-4">
            <a href="https://dataio.artpark.ai/docs" target="_blank" rel="noopener noreferrer" class="hover:text-gray-900">Docs</a>
            <a href="https://github.com/dsih-artpark/dataio" target="_blank" rel="noopener noreferrer" class="hover:text-gray-900">GitHub</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../../styles/global.css';
</style>
