---
// Public landing page - the main website entry point
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ARTPARK Data Platform - Discover, access, and manage geospatial and research datasets. Built at ARTPARK, IISc Bangalore." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ARTPARK Data Platform</title>
  </head>
  <body class="min-h-screen bg-white">
    <!-- Navigation -->
    <header class="fixed top-0 left-0 right-0 bg-white/80 backdrop-blur-md border-b border-gray-100 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
              <span class="text-white font-bold text-sm">AP</span>
            </div>
            <span class="text-lg sm:text-xl font-bold text-gray-900">ARTPARK Data Platform</span>
          </div>
          <nav class="flex items-center gap-3 sm:gap-6">
            <a href="#researchers" class="text-gray-600 hover:text-gray-900 text-sm font-medium hidden md:block">
              For Researchers
            </a>
            <a href="#developers" class="text-gray-600 hover:text-gray-900 text-sm font-medium hidden md:block">
              For Developers
            </a>
            <a href="/datasets" class="text-gray-600 hover:text-gray-900 text-sm font-medium hidden sm:block">
              Datasets
            </a>
            <!-- Resources Dropdown -->
            <div class="relative hidden sm:block group" id="resources-dropdown">
              <button
                class="text-gray-600 hover:text-gray-900 text-sm font-medium flex items-center gap-1"
              >
                Resources
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                <a href="https://dataio.artpark.ai/docs" target="_blank" rel="noopener noreferrer" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg class="w-4 h-4 mr-2.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                  dataio docs
                </a>
                <a href="https://dataio.artpark.ai/api/v1/" target="_blank" rel="noopener noreferrer" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg class="w-4 h-4 mr-2.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                  API Docs
                </a>
                <hr class="my-1 border-gray-100" />
                <a href="https://github.com/dsih-artpark/dataio" target="_blank" rel="noopener noreferrer" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <svg class="w-4 h-4 mr-2.5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  GitHub
                </a>
                <a href="https://pypi.org/project/dataio-artpark/" target="_blank" rel="noopener noreferrer" class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                  <img src="/pypi_logo.svg.png" alt="PyPI" class="w-4 h-4 mr-2.5" />
                  PyPI
                </a>
              </div>
            </div>
            <a href="/login" id="auth-link" class="btn-primary text-sm">
              Sign In
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="pt-24 sm:pt-32 pb-16 sm:pb-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-primary-50 to-white">
        <div class="max-w-6xl mx-auto">
          <!-- Hero Content -->
          <div class="text-center relative z-10 mb-12 sm:mb-16">
            <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight opacity-0">
              Four years of curated<br class="hidden sm:block" />
              <span class="text-primary-600">geospatial datasets</span><br class="hidden sm:block" />
              at your fingertips
            </h1>
            <p class="hero-subtitle mt-6 text-base sm:text-lg md:text-xl text-gray-600 max-w-3xl mx-auto px-4 opacity-0">
              Research-grade datasets assembled and standardised at ARTPARK.
              Tabular data, weather records, and shapefiles — all following common standards.
            </p>
            <div class="hero-cta mt-8 sm:mt-10 flex flex-col sm:flex-row gap-4 justify-center px-4 opacity-0">
              <a href="/datasets" class="btn-primary px-6 sm:px-8 py-3 text-base justify-center">
                Explore Datasets
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a href="#developers" class="btn-secondary px-6 sm:px-8 py-3 text-base justify-center">
                View API & SDKs
              </a>
            </div>
          </div>

          <!-- Floating Data Type Bubbles -->
          <div class="flex flex-wrap justify-center gap-2 sm:gap-3" aria-label="Available data types">
            <div class="bubble bubble-1 px-3 py-1.5 bg-red-100 text-red-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-red-200">
              Dengue
            </div>
            <div class="bubble bubble-2 px-3 py-1.5 bg-orange-100 text-orange-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-orange-200">
              Foot-and-mouth Disease
            </div>
            <div class="bubble bubble-3 px-3 py-1.5 bg-blue-100 text-blue-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-blue-200">
              Human Census
            </div>
            <div class="bubble bubble-4 px-3 py-1.5 bg-indigo-100 text-indigo-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-indigo-200">
              Livestock Census
            </div>
            <div class="bubble bubble-5 px-3 py-1.5 bg-purple-100 text-purple-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-purple-200">
              Population Surveys
            </div>
            <div class="bubble bubble-6 px-3 py-1.5 bg-cyan-100 text-cyan-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-cyan-200">
              ERA5 Reanalysis
            </div>
            <div class="bubble bubble-7 px-3 py-1.5 bg-green-100 text-green-700 rounded-full text-xs sm:text-sm font-medium shadow-sm border border-green-200">
              State • District • City • Ward Shapefiles
            </div>
          </div>
        </div>
      </section>

      <!-- For Researchers Section -->
      <section id="researchers" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-white">
        <div class="max-w-7xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div>
              <h2 class="text-xl sm:text-2xl font-semibold text-primary-600 mb-3">
                For Researchers & Scientists
              </h2>
              <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6">
                Find the data you need,<br class="hidden sm:block" />
                without the hassle
              </h3>
              <p class="text-base sm:text-lg text-gray-600 mb-8">
                Browse through datasets curated over four years at ARTPARK. Each dataset comes with
                comprehensive data dictionaries, standardised formats, and clear documentation.
              </p>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Data Dictionaries</p>
                    <p class="text-gray-600 text-sm">Every dataset includes detailed field descriptions, units, and methodology documentation</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Multiple Data Types</p>
                    <p class="text-gray-600 text-sm">Tabular datasets, weather station records, and geospatial shapefiles in standard formats</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Consistent Structure</p>
                    <p class="text-gray-600 text-sm">All datasets follow the same schema conventions — easy to read and compare across sources</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Versioned Datasets</p>
                    <p class="text-gray-600 text-sm">Track changes and access historical versions for reproducible research</p>
                  </div>
                </li>
              </ul>
              <div class="mt-8">
                <a href="/datasets" class="btn-primary px-6 py-2.5 text-sm font-medium inline-flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                  </svg>
                  Browse Datasets
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
            <div class="bg-gray-50 rounded-2xl p-4 sm:p-8 border border-gray-200">
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-4 py-3 border-b border-gray-200 bg-gray-50">
                  <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400"></div>
                  </div>
                </div>
                <div class="p-4 space-y-3">
                  <div class="flex items-center space-x-2">
                    <div class="h-8 bg-gray-100 rounded flex-1"></div>
                    <div class="h-8 w-20 sm:w-24 bg-primary-100 rounded"></div>
                  </div>
                  <div class="border border-gray-200 rounded-lg overflow-x-auto">
                    <table class="w-full text-xs">
                      <thead class="bg-gray-50 text-gray-600 font-medium">
                        <tr>
                          <th class="px-3 py-2 text-left">Dataset</th>
                          <th class="px-3 py-2 text-left hidden sm:table-cell">Type</th>
                          <th class="px-3 py-2 text-left">Coverage</th>
                          <th class="px-3 py-2 text-left">Access</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-gray-200">
                        <tr>
                          <td class="px-3 py-2 text-gray-900">IMD Weather Stations</td>
                          <td class="px-3 py-2 text-gray-600 hidden sm:table-cell">Tabular</td>
                          <td class="px-3 py-2 text-gray-600">2020-2024</td>
                          <td class="px-3 py-2"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs">Open</span></td>
                        </tr>
                        <tr>
                          <td class="px-3 py-2 text-gray-900">Karnataka Districts</td>
                          <td class="px-3 py-2 text-gray-600 hidden sm:table-cell">Shapefile</td>
                          <td class="px-3 py-2 text-gray-600">2023</td>
                          <td class="px-3 py-2"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs">Open</span></td>
                        </tr>
                        <tr>
                          <td class="px-3 py-2 text-gray-900">Crop Yield Records</td>
                          <td class="px-3 py-2 text-gray-600 hidden sm:table-cell">Tabular</td>
                          <td class="px-3 py-2 text-gray-600">2015-2023</td>
                          <td class="px-3 py-2"><span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs">Request</span></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- For Developers Section -->
      <section id="developers" class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-gray-900">
        <div class="max-w-7xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
            <div class="order-2 lg:order-1">
              <!-- Code Example Tabs -->
              <div class="bg-gray-800 rounded-2xl border border-gray-700 overflow-hidden">
                <div class="flex border-b border-gray-700">
                  <button id="tab-cli" class="code-tab active flex-1 px-3 sm:px-4 py-3 text-xs sm:text-sm font-medium text-white bg-gray-700 border-b-2 border-primary-500" onclick="switchTab('cli')">
                    CLI
                  </button>
                  <button id="tab-python" class="code-tab flex-1 px-3 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-400 hover:text-white" onclick="switchTab('python')">
                    Python SDK
                  </button>
                  <button id="tab-api" class="code-tab flex-1 px-3 sm:px-4 py-3 text-xs sm:text-sm font-medium text-gray-400 hover:text-white" onclick="switchTab('api')">
                    REST API
                  </button>
                </div>
                <div class="p-4 sm:p-6">
                  <!-- CLI Example -->
                  <div id="code-cli" class="code-content">
                    <div class="flex items-center space-x-2 mb-4">
                      <span class="text-gray-400 text-sm">terminal</span>
                    </div>
                    <pre class="text-xs sm:text-sm text-gray-300 overflow-x-auto whitespace-pre-wrap"><code><span class="text-gray-500"># Install with uv (recommended)</span>
<span class="text-green-400">$</span> uv init && uv add dataio-artpark

<span class="text-gray-500"># Initialize and configure credentials</span>
<span class="text-green-400">$</span> uv run dataio init

<span class="text-gray-500"># List datasets by collection</span>
<span class="text-green-400">$</span> uv run dataio list-datasets --collection "Census Data"

<span class="text-gray-500"># Download a dataset with metadata</span>
<span class="text-green-400">$</span> uv run dataio download-dataset TS0001DS0042</code></pre>
                  </div>
                  <!-- Python SDK Example -->
                  <div id="code-python" class="code-content hidden">
                    <div class="flex items-center space-x-2 mb-4">
                      <span class="text-gray-400 text-sm">example.py</span>
                    </div>
                    <pre class="text-xs sm:text-sm text-gray-300 overflow-x-auto whitespace-pre-wrap"><code><span class="text-purple-400">from</span> dataio <span class="text-purple-400">import</span> DataIOAPI

<span class="text-gray-500"># Initialize client (reads from .env)</span>
client = DataIOAPI()

<span class="text-gray-500"># List all datasets</span>
datasets = client.list_datasets(limit=<span class="text-blue-400">50</span>)

<span class="text-gray-500"># Get dataset details</span>
details = client.get_dataset_details(<span class="text-green-400">"TS0001DS0042"</span>)

<span class="text-gray-500"># Download dataset with metadata</span>
path = client.download_dataset(
    <span class="text-green-400">"TS0001DS0042"</span>,
    root_dir=<span class="text-green-400">"./data"</span>
)</code></pre>
                  </div>
                  <!-- REST API Example -->
                  <div id="code-api" class="code-content hidden overflow-hidden">
                    <div class="flex items-center space-x-2 mb-4">
                      <span class="text-gray-400 text-sm">curl</span>
                    </div>
                    <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
                      <pre class="text-xs sm:text-sm text-gray-300 min-w-max"><code><span class="text-gray-500"># List datasets</span>
<span class="text-green-400">$</span> curl -H <span class="text-green-400">"X-API-Key: $API_KEY"</span> \
  <span class="text-green-400">"https://dataio.artpark.ai/api/v1/datasets"</span>

<span class="text-gray-500"># Get dataset tables</span>
<span class="text-green-400">$</span> curl -H <span class="text-green-400">"X-API-Key: $API_KEY"</span> \
  <span class="text-green-400">".../datasets/TS0001DS0042/STANDARDISED/tables"</span>

<span class="text-gray-500"># Download shapefile as GeoJSON</span>
<span class="text-green-400">$</span> curl -H <span class="text-green-400">"X-API-Key: $API_KEY"</span> \
  <span class="text-green-400">".../shapefiles/state_29"</span></code></pre>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4 flex flex-col sm:flex-row items-center justify-center gap-3 text-sm">
                <a href="https://pypi.org/project/dataio-artpark/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-gray-400 hover:text-white">
                  <img src="/pypi_logo.svg.png" alt="PyPI" class="w-4 h-4 mr-1.5" />
                  PyPI
                </a>
                <span class="text-gray-600 hidden sm:inline">•</span>
                <a href="https://dataio.artpark.ai/docs" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300">
                  View full documentation →
                </a>
              </div>
            </div>
            <div class="order-1 lg:order-2">
              <h2 class="text-xl sm:text-2xl font-semibold text-primary-400 mb-3">
                For Developers
              </h2>
              <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4">
                Powered by a <span class="text-primary-400">first class API</span>
              </h3>
              <p class="text-base sm:text-lg text-gray-400 mb-6">
                We built <a href="https://dataio.artpark.ai" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold">dataio</a> to power our own research workflows — and now it powers this platform too!
                It's open-source on <a href="https://pypi.org/project/dataio-artpark/" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold">PyPI</a>, with a <a href="https://dataio.artpark.ai/docs/cli/" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold">CLI</a> for quick access, a <a href="https://dataio.artpark.ai/docs/sdk" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold">Python SDK</a> for scripting, and a <a href="https://dataio.artpark.ai/api/v1" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:text-primary-300 font-semibold">REST API</a>
                for full programmatic control.
              </p>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-gray-700 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-white">CLI Tool & Python SDK</p>
                    <p class="text-gray-400 text-sm">Quick dataset discovery and download from your terminal or Python scripts</p>
                  </div>
                </li>
                <li class="flex items-start">
                  <div class="w-6 h-6 rounded-full bg-gray-700 flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">
                    <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-white">REST API</p>
