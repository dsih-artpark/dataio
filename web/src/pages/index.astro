---
// Redirect to dashboard if authenticated, otherwise show public datasets
// This is handled client-side since we can't access localStorage on the server
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DataIO</title>
  </head>
  <body>
    <script>
      const token = localStorage.getItem('access_token');
      if (token) {
        // Basic JWT expiry check (payload is base64url encoded)
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          if (payload.exp && payload.exp * 1000 > Date.now()) {
            window.location.href = '/dashboard';
          } else {
            localStorage.removeItem('access_token');
            localStorage.removeItem('refresh_token');
            // Show public datasets for unauthenticated users
            window.location.href = '/datasets';
          }
        } catch {
          localStorage.removeItem('access_token');
          // Show public datasets for unauthenticated users
          window.location.href = '/datasets';
        }
      } else {
        // Show public datasets for unauthenticated users
        window.location.href = '/datasets';
      }
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/datasets" />
    </noscript>
  </body>
</html>
