---
// Public landing page (redesign wireframe v2, "Landing"). Static sections are
// rendered here; live numbers and lists come from islands that call
// /public/stats and /public/datasets in the browser.
import PublicLayout from '../layouts/PublicLayout.astro';
import HeroStats from '../components/public/landing/HeroStats';
import ThemeGrid from '../components/public/landing/ThemeGrid';
import CoverageMap from '../components/public/landing/CoverageMap';
import RecentlyUpdated from '../components/public/landing/RecentlyUpdated';
import CodeTabs from '../components/public/landing/CodeTabs';
import { ACCESS_DESCRIPTIONS } from '../lib/catalogue';
import { COMING_SOON_THEME, POPULAR_SEARCHES, THEMES, datasetsHref } from '../lib/landing';
import { CONTACT_EMAIL, PLATFORM_NAME } from '../lib/site';

const STANDARDS_URL = 'https://engg.artpark.ai/data_standardisation/workflow.html';

// Hero theme shortcuts: the six themes the wireframe shows.
const heroThemes = THEMES.filter((theme) => ['EP', 'CS', 'GS', 'MW', 'ET'].includes(theme.id));

const audiences = [
  {
    title: 'NGOs & programme teams',
    text: 'District- and village-level figures for planning, targeting and reporting. No data team needed to clean them.',
    points: [
      'Find data for your state or district',
      'Plain-language descriptions of every column',
      'Download as a spreadsheet-friendly file',
    ],
    link: { label: 'Find data for your region', href: '#coverage' },
    icon: '<path d="M12 21s-7-4.5-7-11a7 7 0 0 1 14 0c0 6.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  },
  {
    title: 'Researchers',
    text: 'Standardised, versioned datasets with full data dictionaries and sources, so your analysis is reproducible and citable.',
    points: ['Units, methods and sources documented', 'Versions you can cite and come back to', 'Python SDK, CLI and REST API'],
    link: { label: 'Browse the catalogue', href: '/datasets' },
    icon: '<path d="M9 3h6"/><path d="M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/>',
  },
  {
    title: 'Philanthropy',
    text: 'See what evidence exists for a region or issue, where the gaps are, and how shared data infrastructure multiplies the impact of your grants.',
    points: ['Coverage by theme, place and time', 'Data your grantees can reuse', 'Open, public-interest infrastructure'],
    link: { label: 'Support or partner with us', href: '#partner' },
    icon: '<path d="M3 20h18"/><path d="M6 16v-5"/><path d="M11 16V7"/><path d="M16 16v-3"/><path d="M20 16V5"/>',
  },
  {
    title: 'Government',
    text: 'State and district figures from many departments that line up with each other, for planning, monitoring and reporting.',
    points: [
      'Data by state, district and village',
      'Official LGD codes, so datasets join up',
      'Share your department’s data with us',
    ],
    link: { label: 'Find or share data', href: '#partner' },
    icon: '<path d="M3 21h18"/><path d="M5 21V10"/><path d="M9 21V10"/><path d="M15 21V10"/><path d="M19 21V10"/><path d="M12 3 3 8h18z"/>',
  },
];

const steps: { title: string; text: string; link?: { label: string; href: string } }[] = [
  {
    title: 'Collect',
    text: 'From government sources, published studies and partner organisations, always with the original source recorded.',
  },
  { title: 'Standardise', text: 'Common place names and codes, dates and units, so datasets line up with each other.' },
  {
    title: 'Check & document',
    text: 'Quality checks on every release, a description for every column, and a version history.',
  },
  {
    title: 'Share responsibly',
    text: 'Open where possible, protected where needed. Sensitive data stays restricted and is shared on request.',
  },
];

// Logos from the "Partners and Research Collaborators" deck, in public/logos/
// (trimmed, 2x display height, WebP).
interface Logo {
  name: string;
  file: string;
}
const logo = (name: string, file: string): Logo => ({ name, file: `/logos/${file}.webp` });
const dataSources = [
  logo('Government of Karnataka', 'gov-karnataka'),
  logo('NVBDCP', 'nvbdcp'),
  logo('India Meteorological Department', 'imd'),
  logo('Indian Institute of Tropical Meteorology', 'iitm'),
  logo('ICMR National Institute of Virology', 'icmr-niv'),
];
const collaborators = [
  logo('Google Research', 'google-research'),
  logo('National Disease Modelling Consortium', 'ndmc'),
  logo('Indian Institute of Science', 'iisc'),
  logo('International Centre for Theoretical Sciences', 'icts'),
  logo('The Institute of Mathematical Sciences', 'imsc'),
  logo('BITS Pilani', 'bits-pilani'),
  logo('Ashoka University', 'ashoka-university'),
  logo('Yale School of Public Health', 'yale-public-health'),
  logo('MAPSolve AI', 'mapsolve-ai'),
];
const supporters = [
  logo('India Health Fund', 'india-health-fund'),
  logo('Clinton Foundation', 'clinton-foundation'),
  logo('Asian Venture Philanthropy Network', 'avpn'),
  logo('Centre for Health Research and Innovation', 'chri'),
  logo('Khushi Baby', 'khushi-baby'),
];

const stories = [
  {
    tag: 'Government',
    title: 'Dengue forecasts for state health departments',
    text: 'Short-term dengue forecasts built on case, weather and climate data, now live in Karnataka, Andhra Pradesh and Odisha and used in state health dashboards.',
    href: 'https://www.artpark.in/health-initiatives/dengue-dashboard',
    placeholder: false,
  },
  {
    tag: 'Research',
    title: 'Datalab: livestock [story title]',
    text: '[One or two lines on the livestock study or model]',
    href: null,
    placeholder: true,
  },
  {
    tag: 'Research',
    title: 'APSI / Dharini [story title]',
    text: '[One or two lines on what the APSI / Dharini programme did with the data, and the outcome]',
    href: 'https://www.artpark.in/health-initiatives/environmental-survelliance',
    placeholder: true,
  },
];

const mailto = (subject: string, body: string) =>
  `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const contributeHref = mailto(
  'Data contribution',
  'Hi,\r\n\r\nI would like to contribute data.\r\n\r\nDataset name:\r\nOrganisation:\r\nShort description:\r\nFormat (CSV, Excel, PDF, other):\r\nLink to the data (if any):\r\nHow it should be shared (open, view only or restricted):\r\n',
);
const requestHref = mailto(
  'Dataset request',
  'Hi,\r\n\r\nI could not find a dataset I need.\r\n\r\nWhat data:\r\nWhich place (state, district or other):\r\nWhich years:\r\nWhat you will use it for:\r\nYour organisation:\r\n',
);
const partnerHref = mailto('Partnership', 'Hi,\r\n\r\nWe would like to talk about supporting or partnering with the One Health data commons.\r\n\r\nOrganisation:\r\n');

const eyebrow = 'm-0 text-[13px] font-semibold uppercase tracking-[0.08em] text-primary-700';
const h2 = 'm-0 text-[28px] sm:text-4xl leading-tight font-bold text-gray-900';
const intro = 'm-0 text-[17px] leading-relaxed text-gray-600 max-w-[680px]';
const textLink = 'font-semibold text-primary-700 hover:text-primary-900';
const logoImg = 'block w-auto object-contain';
---

<PublicLayout title={PLATFORM_NAME} width="full" background="white" backToTop>
  <!-- HERO -->
  <section aria-labelledby="hero-heading" class="bg-gradient-to-b from-primary-50 to-white px-4 sm:px-6 pt-14 sm:pt-[72px] pb-16">
    <div class="max-w-[920px] mx-auto text-center flex flex-col items-center gap-5">
      <p class={eyebrow}>ARTPARK · IISc Bengaluru</p>
      <h1 id="hero-heading" class="m-0 text-4xl sm:text-[52px] leading-[1.12] font-bold tracking-[-0.01em] text-gray-900">
        One Health data for India
      </h1>
      <p class="m-0 max-w-[720px] text-[17px] sm:text-[19px] leading-relaxed text-gray-600">
        Human and animal disease records, population and livestock censuses, and weather data, linked by state,
        district and village.
      </p>

      <form
        role="search"
        action="/datasets"
        method="get"
        class="mt-3 w-full max-w-[720px] flex flex-wrap gap-2 bg-white border border-gray-300 rounded-xl p-2 shadow-sm focus-within:ring-2 focus-within:ring-primary-500 focus-within:border-primary-500"
      >
        <label for="hero-search" class="sr-only">Search datasets</label>
        <input
          id="hero-search"
          name="search"
          type="search"
          placeholder="Search datasets by name, topic or place, e.g. “dengue Karnataka”"
          class="flex-[1_1_280px] min-w-0 border-0 bg-transparent px-3 py-3 text-base text-gray-900 placeholder:text-gray-500 focus:outline-none focus:ring-0"
        />
        <button
          type="submit"
          class="flex-[1_1_auto] sm:flex-none min-h-[44px] px-[22px] rounded-lg bg-primary-600 text-white text-[15px] font-semibold hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
        >
          Search datasets
        </button>
      </form>

      <div class="flex flex-wrap justify-center items-center gap-x-2.5 gap-y-2 text-sm text-gray-600">
        <span>Popular searches:</span>
        {
          POPULAR_SEARCHES.map((term) => (
            <a
              href={datasetsHref({ search: term })}
              class="inline-flex items-center min-h-[36px] px-3 rounded-full border border-gray-300 bg-white text-gray-700 hover:border-primary-300 hover:text-primary-900"
            >
              “{term}”
            </a>
          ))
        }
      </div>

      <ul aria-label="Browse by theme" class="m-0 mt-2 p-0 list-none flex flex-wrap justify-center gap-2">
        {
          heroThemes.map((theme) => (
            <li>
              <a
                href={datasetsHref({ category_id: [theme.id] })}
                class={`inline-flex items-center min-h-[36px] px-3.5 rounded-full border text-sm font-medium hover:brightness-95 ${theme.chip}`}
              >
                {theme.label}
              </a>
            </li>
          ))
        }
        <li>
          <span
            class={`inline-flex items-center min-h-[36px] px-3.5 rounded-full border border-dashed text-sm font-medium opacity-80 ${COMING_SOON_THEME.chip}`}
          >
            {COMING_SOON_THEME.label} <span class="ml-1 text-xs">(coming soon)</span>
          </span>
        </li>
      </ul>

      <HeroStats client:load />
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section id="audiences" aria-labelledby="audiences-heading" class="py-16 sm:py-20 bg-white scroll-mt-4">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <p class={`${eyebrow} mb-2`}>Who it’s for</p>
      <h2 id="audiences-heading" class={`${h2} mb-3`}>One place to start, whatever your role</h2>
      <p class={`${intro} mb-10`}>
        Every dataset is cleaned, documented and described the same way, so you spend less time finding and fixing data
        and more time using it.
      </p>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
        {
          audiences.map((audience) => (
            <article class="border border-gray-200 rounded-2xl p-7 flex flex-col gap-3.5 bg-white">
              <div aria-hidden="true" class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-primary-600"
                  set:html={audience.icon}
                />
              </div>
              <h3 class="m-0 text-[22px] font-bold">{audience.title}</h3>
              <p class="m-0 text-base leading-relaxed text-gray-600">{audience.text}</p>
              <ul class="m-0 pl-5 list-disc text-[15px] leading-[1.8] text-gray-700">
                {audience.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a href={audience.link.href} class={`mt-auto text-[15px] ${textLink}`}>
                {audience.link.label} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <section id="approach" aria-labelledby="approach-heading" class="py-16 sm:py-20 bg-white border-t border-gray-200 scroll-mt-4">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <p class={`${eyebrow} mb-2`}>Our approach</p>
      <h2 id="approach-heading" class={`${h2} mb-3`}>Why you can rely on this data</h2>
      <p class={`${intro} mb-10`}>
        Public data in India is scattered across portals, PDFs and spreadsheets in different formats. We do the slow work
        once, in the open, so everyone can build on it.
      </p>
      <ol class="m-0 p-0 list-none grid gap-5 grid-cols-1 sm:grid-cols-2 xl:grid-cols-4">
        {
          steps.map((step, index) => (
            <li class="p-6 rounded-[14px] bg-primary-50 flex flex-col gap-2.5">
              <span class="text-sm font-bold text-primary-700" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="m-0 text-[19px] font-bold">{step.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-gray-700">{step.text}</p>
              {step.link && (
                <a href={step.link.href} class={`text-sm ${textLink}`}>
                  {step.link.label} →
                </a>
              )}
            </li>
          ))
        }
      </ol>

      <div class="mt-8 p-7 rounded-2xl border border-primary-200 bg-white flex flex-wrap gap-x-8 gap-y-5 items-center">
        <div aria-hidden="true" class="w-14 h-14 shrink-0 rounded-[14px] bg-primary-100 flex items-center justify-center">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600">
            <path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><path d="M8 12h8"></path>
          </svg>
        </div>
        <div class="flex-[1_1_420px] min-w-0 flex flex-col gap-1.5">
          <h3 class="m-0 text-xl font-bold">Join datasets without the clean-up</h3>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">
            Every dataset uses the Government of India’s official LGD (Local Government Directory) codes for states,
            districts, sub-districts and villages, the same date format and documented units. Census figures, case counts
            and rainfall for a district line up in a single join.
          </p>
        </div>
        <a href={STANDARDS_URL} target="_blank" rel="noopener noreferrer" class={`text-[15px] ${textLink}`}>
          Read our data standards →
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col gap-4">
        <h3 class="m-0 text-sm font-semibold text-gray-600">Data from</h3>
        <ul class="m-0 p-0 list-none flex flex-wrap items-center gap-x-10 gap-y-6">
          {
            dataSources.map((item) => (
              <li>
                <img src={item.file} alt={item.name} title={item.name} loading="lazy" decoding="async" class={`${logoImg} h-14 sm:h-16 max-w-[240px]`} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- BROWSE BY THEME -->
  <section aria-labelledby="themes-heading" class="py-16 sm:py-[72px] bg-gray-50 border-y border-gray-200">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap justify-between items-end gap-4 mb-8">
        <div>
          <p class={`${eyebrow} mb-2`}>Browse by theme</p>
          <h2 id="themes-heading" class="m-0 text-[28px] sm:text-[32px] font-bold text-gray-900">What’s in the catalogue</h2>
        </div>
        <a href="/datasets" class={`text-[15px] ${textLink}`}>See all datasets →</a>
      </div>
      <ThemeGrid client:visible />
    </div>
  </section>

  <!-- DATA FOR YOUR AREA -->
  <section id="coverage" aria-labelledby="coverage-heading" class="py-16 sm:py-[72px] bg-white border-b border-gray-200 scroll-mt-4">
    <CoverageMap client:visible />
  </section>

  <!-- DATA IN USE -->
  <section aria-labelledby="stories-heading" class="py-16 sm:py-20 bg-white">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <p class={`${eyebrow} mb-2`}>Data in use</p>
      <h2 id="stories-heading" class="m-0 mb-8 text-[28px] sm:text-[32px] leading-tight font-bold text-gray-900">
        What people have done with it
      </h2>
      <div class="flex flex-wrap gap-6">
        {
          stories.map((story) => (
            <article class="flex-[1_1_320px] min-w-0 border border-gray-200 rounded-2xl overflow-hidden flex flex-col">
              <div class="h-40 bg-gray-100 flex items-center justify-center text-[13px] text-gray-600">
                [Photo or chart from the project]
              </div>
              <div class="p-[22px] flex flex-col gap-2 flex-1">
                <span class="text-[13px] font-semibold text-primary-700">{story.tag}</span>
                <h3 class="m-0 text-[19px] font-bold">{story.title}</h3>
                <p class="m-0 text-[15px] leading-relaxed text-gray-600">{story.text}</p>
                {story.href ? (
                  <a href={story.href} target="_blank" rel="noopener noreferrer" class={`mt-auto text-[15px] ${textLink}`}>
                    Read more on the ARTPARK site →
                  </a>
                ) : (
                  <span class="mt-auto text-[15px] text-gray-500">[Link to come]</span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RECENTLY UPDATED -->
  <section aria-labelledby="recent-heading" class="py-16 sm:py-[72px] bg-gray-50 border-y border-gray-200">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap justify-between items-end gap-4 mb-6">
        <h2 id="recent-heading" class="m-0 text-[28px] font-bold text-gray-900 flex items-center gap-2.5">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
          </svg>
          Recently updated
        </h2>
        <a href={datasetsHref({ sort: 'updated' })} class={`text-[15px] ${textLink}`}>View all →</a>
      </div>
      <RecentlyUpdated client:visible />
    </div>
  </section>

  <!-- HOW ACCESS WORKS -->
  <section id="access" aria-labelledby="access-heading" class="py-16 sm:py-[72px] bg-white scroll-mt-4">
    <div class="max-w-page mx-auto px-4 sm:px-6">
      <h2 id="access-heading" class="m-0 mb-2 text-[28px] font-bold text-gray-900">How access works</h2>
      <p class="m-0 mb-7 text-base leading-relaxed text-gray-600 max-w-[680px]">
        Each dataset shows one of three access levels. Open datasets need no account. For the rest, use “Request access”
        on the dataset’s page and we add you to the access list.
      </p>
      <div class="flex flex-wrap gap-4">
        <div class="flex-[1_1_300px] p-[22px] border border-gray-200 rounded-[14px] flex flex-col gap-2">
          <span class="self-start px-2.5 py-1 rounded-full bg-green-100 text-green-800 text-[13px] font-semibold">Open download</span>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">{ACCESS_DESCRIPTIONS.DOWNLOAD}</p>
        </div>
        <div class="flex-[1_1_300px] p-[22px] border border-gray-200 rounded-[14px] flex flex-col gap-2">
          <span class="self-start px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[13px] font-semibold">View only</span>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">{ACCESS_DESCRIPTIONS.VIEW}</p>
          <figure class="m-0 border border-gray-200 rounded-lg overflow-hidden text-[13px]">
            <figcaption class="flex justify-between items-center px-2.5 py-1.5 bg-gray-100 text-gray-700 font-semibold">
              <span>Preview</span>
              <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-xs">Synthetic preview only</span>
            </figcaption>
            <table class="w-full border-collapse text-left text-gray-700">
              <thead>
                <tr class="border-t border-gray-200">
                  <th scope="col" class="px-2.5 py-1.5 font-semibold">district</th>
                  <th scope="col" class="px-2.5 py-1.5 font-semibold">year</th>
                  <th scope="col" class="px-2.5 py-1.5 font-semibold">cases</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-t border-gray-100"><td class="px-2.5 py-1.5">Bagalkote</td><td class="px-2.5 py-1.5">2023</td><td class="px-2.5 py-1.5">18</td></tr>
                <tr class="border-t border-gray-100"><td class="px-2.5 py-1.5">Belagavi</td><td class="px-2.5 py-1.5">2023</td><td class="px-2.5 py-1.5">31</td></tr>
              </tbody>
            </table>
          </figure>
          <a href={datasetsHref({ access_level: ['VIEW'] })} class={`text-sm ${textLink}`}>Find View only datasets →</a>
        </div>
        <div class="flex-[1_1_300px] p-[22px] border border-gray-200 rounded-[14px] flex flex-col gap-2">
          <span class="self-start px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 text-[13px] font-semibold">Restricted</span>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">{ACCESS_DESCRIPTIONS.NONE}</p>
          <a href={datasetsHref({ access_level: ['NONE'] })} class={`text-sm ${textLink}`}>Find Restricted datasets →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DEVELOPERS -->
  <section id="developers" aria-labelledby="developers-heading" class="py-16 bg-primary-950 text-white scroll-mt-4">
    <div class="max-w-page mx-auto px-4 sm:px-6 flex flex-wrap gap-10 items-center">
      <div class="flex-[1_1_380px] min-w-0 flex flex-col gap-3.5">
        <p class="m-0 text-[13px] font-semibold uppercase tracking-[0.08em] text-primary-200">For developers &amp; analysts</p>
        <h2 id="developers-heading" class="m-0 text-[26px] sm:text-[30px] leading-tight font-bold">Pull data straight into your code</h2>
        <p class="m-0 text-base leading-relaxed text-primary-100">
          Python SDK, command-line tool and REST API. The same structure across datasets means code written for one works
          for the next.
        </p>
        <div class="flex flex-wrap gap-4 text-[15px]">
          <a href="https://dataio.artpark.ai/docs" target="_blank" rel="noopener noreferrer" class="font-semibold text-white underline-offset-4 hover:underline">Documentation</a>
          <a href="https://github.com/dsih-artpark/dataio" target="_blank" rel="noopener noreferrer" class="font-semibold text-white underline-offset-4 hover:underline">GitHub</a>
          <a href="https://pypi.org/project/dataio-artpark/" target="_blank" rel="noopener noreferrer" class="font-semibold text-white underline-offset-4 hover:underline">PyPI</a>
        </div>
      </div>
      <CodeTabs client:visible />
    </div>
  </section>

  <!-- FIND / SHARE / REQUEST -->
  <section id="partner" aria-labelledby="partner-heading" class="py-16 sm:py-20 bg-white scroll-mt-4">
    <div class="max-w-page mx-auto px-4 sm:px-6 flex flex-col gap-7">
      <h2 id="partner-heading" class="m-0 text-[28px] sm:text-[32px] leading-tight font-bold text-gray-900">
        Use it, add to it, or ask for what’s missing
      </h2>
      <div class="flex flex-wrap gap-5">
        <div class="flex-[1_1_300px] p-7 rounded-2xl bg-primary-50 flex flex-col gap-2.5">
          <h3 class="m-0 text-[21px] font-bold">Find data</h3>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">Search documented datasets and download what you need.</p>
          <a href="/datasets" class="mt-auto self-start inline-flex items-center min-h-[44px] px-[18px] rounded-[10px] bg-primary-600 text-white font-semibold text-[15px] hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2">
            Search datasets
          </a>
        </div>
        <div class="flex-[1_1_300px] p-7 rounded-2xl bg-primary-50 flex flex-col gap-2.5">
          <h3 class="m-0 text-[21px] font-bold">Contribute data</h3>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">
            NGOs, research groups and departments: we help standardise and document your data. You choose how it is shared
            (open, view only or restricted), and credit always goes to you.
          </p>
          <a href={contributeHref} class="mt-auto self-start inline-flex items-center min-h-[44px] px-[18px] rounded-[10px] bg-white border border-primary-200 text-primary-900 font-semibold text-[15px] hover:border-primary-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
            Contribute data
          </a>
        </div>
        <div class="flex-[1_1_300px] p-7 rounded-2xl bg-primary-50 flex flex-col gap-2.5">
          <h3 class="m-0 text-[21px] font-bold">Request a dataset</h3>
          <p class="m-0 text-[15px] leading-relaxed text-gray-700">
            Can’t find it? Tell us what you need and for which place and years. We’ll let you know if we can add it.
          </p>
          <a href={requestHref} class="mt-auto self-start inline-flex items-center min-h-[44px] px-[18px] rounded-[10px] bg-white border border-primary-200 text-primary-900 font-semibold text-[15px] hover:border-primary-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
            Request a dataset
          </a>
        </div>
      </div>
      <p class="m-0 text-base text-gray-700">
        <strong>Philanthropies and partners:</strong> support shared, open data infrastructure for public health and
        livelihoods. <a href={partnerHref} class={textLink}>Partner with us →</a>
      </p>
    </div>
  </section>

  <!-- PARTNERS -->
  <section aria-labelledby="partners-heading" class="py-14 bg-white border-t border-gray-200">
    <div class="max-w-page mx-auto px-4 sm:px-6 flex flex-col gap-8">
      <h2 id="partners-heading" class="m-0 text-2xl font-bold text-gray-900">Partners</h2>
      <div class="flex flex-col gap-4">
        <h3 class="m-0 text-sm font-semibold text-gray-600">Research collaborators</h3>
        <!-- Scrolling strip: the set is repeated once (hidden from screen readers) so the loop is seamless.
             Pauses on hover/focus; with reduced motion it becomes a static wrapped row. -->
        <div class="marquee overflow-hidden">
          <div class="marquee-track flex w-max">
            {
              [false, true].map((copy) => (
                <ul class="marquee-set m-0 p-0 list-none flex items-center gap-14 pr-14" aria-hidden={copy ? 'true' : undefined}>
                  {collaborators.map((item) => (
                    <li class="shrink-0">
                      <img src={item.file} alt={copy ? '' : item.name} title={item.name} loading="lazy" decoding="async" class={`${logoImg} h-12 max-w-[180px]`} />
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="m-0 text-sm font-semibold text-gray-600">Supported by</h3>
        <ul class="m-0 p-0 list-none flex flex-wrap items-center gap-x-10 gap-y-6">
          {
            supporters.map((item) => (
              <li>
                <img src={item.file} alt={item.name} title={item.name} loading="lazy" decoding="async" class={`${logoImg} h-12 max-w-[180px]`} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .marquee {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee-track {
    animation: marquee 40s linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      width: auto;
    }
    .marquee-set {
      flex-wrap: wrap;
      row-gap: 1.5rem;
    }
    .marquee-set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
