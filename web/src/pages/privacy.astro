---
// Privacy Policy, from docs/legal/privacy-policy.md (draft, under review: not indexed).
import PublicLayout from '../layouts/PublicLayout.astro';
import { legalDocHtml } from '../lib/legal';

const html = legalDocHtml('privacy-policy.md');
---

<PublicLayout title="Privacy Policy" description="What personal data the platform collects and why." noindex>
  <article class="max-w-[820px] mx-auto bg-white border border-gray-200 rounded-2xl p-5 sm:p-8">
    <div class="readme-content" set:html={html} />
  </article>
</PublicLayout>
