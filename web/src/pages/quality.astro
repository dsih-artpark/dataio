---
// How we check quality (/quality), following the redesign wireframe
// (Quality.dc.html): the 8-step flow from source document to published
// dataset, which steps are quality checks, and what each dataset page shows.
import PublicLayout from '../layouts/PublicLayout.astro';
import { CONTACT_EMAIL } from '../lib/site';

interface Step {
  title: string;
  text: string;
  /** Highlighted as a quality check. */
  check?: boolean;
  note?: string;
}

const steps: Step[] = [
  { title: 'Source document', text: 'A report or table from the data owner, often a PDF.' },
  { title: 'Extract tables', text: 'Tables are pulled out of the document, page by page.' },
  {
    title: 'Checked against the original',
    text: 'A reviewer compares each table with the source document.',
    check: true,
    note: 'Corrections go back to step 2',
  },
  { title: 'Standardized', text: 'Place names are matched to official LGD names and codes.' },
  {
    title: 'Reshaped and checked automatically',
    text: 'Put into one standard layout, then checked for missing values, duplicates, out-of-range values, units and dates.',
    check: true,
  },
  { title: 'Second review', text: 'A second person reviews the finished dataset.', check: true },
  { title: 'Tested', text: 'We use the dataset the way you would, before it is released.', check: true },
  { title: 'Published', text: 'Released with its source, quality result and version history.' },
];

const details = [
  'A description of every column, with units',
  '[Result of the latest quality check]',
  'Version history: what changed in each update, when and why',
];
---

<PublicLayout
  title="How we check quality"
  description="The checks every dataset goes through before it is published, and what you can see on a dataset page."
  current="approach"
  background="white"
  width="full"
>
  <div class="max-w-[860px] mx-auto px-4 sm:px-6 pt-14 pb-20 flex flex-col gap-8">
    <a href="/#approach" class="self-start text-sm font-semibold text-primary-700 hover:text-primary-900">← Our approach</a>

    <div class="flex flex-col gap-3">
      <p class="m-0 text-[13px] font-semibold tracking-[0.08em] uppercase text-primary-700">Check &amp; document</p>
      <h1 class="m-0 text-[32px] sm:text-[40px] leading-[1.15] font-bold text-gray-900">How we check quality</h1>
      <p class="m-0 text-lg leading-relaxed text-gray-600">
        Every dataset goes through the same checks before it is published, and again each time a new version is
        released. This page explains what we look at and what you can see on a dataset page.
      </p>
    </div>

    <section aria-labelledby="checks-heading" class="flex flex-col gap-4">
      <h2 id="checks-heading" class="m-0 text-[26px] font-bold text-gray-900">What we check</h2>
      <ol class="list-none m-0 p-0 grid gap-3 grid-cols-[repeat(auto-fit,minmax(180px,1fr))]">
        {
          steps.map((step, index) => (
            <li
              class={`p-4 rounded-[14px] border flex flex-col gap-1.5 ${
                step.check ? 'border-primary-200 bg-primary-50' : 'border-gray-200 bg-white'
              }`}
            >
              <div class="flex items-center justify-between">
                <span
                  class={`w-7 h-7 rounded-full text-[13px] font-bold flex items-center justify-center ${
                    step.check ? 'bg-primary-600 text-white' : 'bg-primary-50 text-primary-700'
                  }`}
                >
                  {index + 1}
                </span>
                {index < steps.length - 1 && (
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
                    <path d="M5 12h14" />
                    <path d="M13 6l6 6-6 6" />
                  </svg>
                )}
              </div>
              <h3 class="m-0 text-base font-bold text-gray-900">
                {step.title}
                {step.check && <span class="sr-only"> (quality check)</span>}
              </h3>
              <p class="m-0 text-sm leading-normal text-gray-600">{step.text}</p>
              {step.note && (
                <p class="m-0 text-[13px] leading-snug text-amber-800 flex items-center gap-1.5">
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 14L4 9l5-5" />
                    <path d="M4 9h11a5 5 0 0 1 0 10h-3" />
                  </svg>
                  {step.note}
                </p>
              )}
            </li>
          ))
        }
      </ol>
      <div class="flex flex-wrap gap-x-6 gap-y-2 items-center text-sm text-gray-600">
        <span class="flex items-center gap-2">
          <span aria-hidden="true" class="w-3.5 h-3.5 rounded bg-primary-50 border border-primary-200"></span>
          Quality check
        </span>
        <span>Data that already arrives as tables starts at step 4.</span>
      </div>
    </section>

    <section aria-labelledby="details-heading" class="flex flex-col gap-3">
      <h2 id="details-heading" class="m-0 text-[26px] font-bold text-gray-900">Quality details on every dataset</h2>
      <ul class="m-0 pl-[22px] text-base leading-[1.8] text-gray-700 list-disc">
        {details.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="p-6 rounded-2xl border border-primary-200 bg-white flex flex-wrap gap-x-6 gap-y-4 items-center justify-between">
      <div class="flex-[1_1_360px] flex flex-col gap-1">
        <h2 class="m-0 text-xl font-bold text-gray-900">Read our data standards</h2>
        <p class="m-0 text-[15px] leading-relaxed text-gray-600">
          The rules every dataset follows for place codes, dates, units and column names.
        </p>
      </div>
      <a
        href="https://engg.artpark.ai/data_standardisation/workflow.html"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center min-h-[44px] px-[18px] rounded-[10px] bg-primary-600 text-white font-semibold text-[15px] hover:bg-primary-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
      >
        Data standards →
      </a>
    </section>

    <p class="m-0 text-[15px] text-gray-600">
      Found a problem in a dataset?{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-primary-700 hover:text-primary-900">
        Tell us at {CONTACT_EMAIL}
      </a>
    </p>
  </div>
</PublicLayout>
